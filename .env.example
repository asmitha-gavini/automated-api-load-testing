# ==============================================================================
# LoadPulse Environment Configuration Template
# Copy this file to .env before starting services in custom environments
# ==============================================================================

# Backend Server Configuration
PORT=8080
ENV=production
DB_PATH=/data/loadpulse.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Container Networking Aliases
DEMO_API_HOST=demo-api:8081

# Demo Mock API Server Configuration
DEMO_PORT=8081

# Frontend Configuration (Optional overrides for custom reverse proxies)
VITE_API_URL=
VITE_WS_URL=
